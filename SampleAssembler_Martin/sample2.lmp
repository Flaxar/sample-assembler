# ======================================================================
# Sample Assembler build
# Generated by Sample Assembler — builds geometry and dumps a
# LAMMPS 'custom' snapshot (id type x y z) for TEM multislice.
# ======================================================================

units metal
atom_style atomic
boundary p p p
atom_modify map yes
lattice none 1.0   # placeholder; each fill sets its own lattice

region simbox block -165 40 -60 15 0 75 units box
create_box 4 simbox

# --- masses (global atom types) ---
mass 1 12.011   # C
mass 2 30.974   # P
mass 3 63.546   # Cu
mass 4 114.82   # In

# --- Fill 1: Diamond (C) — ComponentA  [Diamond (C)] ---
lattice custom 3.5668 a1 1.000000000000 0.000000000000 0.000000000000 a2 0.000000000000 1.000000000000 0.000000000000 a3 0.000000000000 0.000000000000 1.000000000000 basis 0.000000 0.000000 0.000000 basis 0.500000 0.500000 0.000000 basis 0.500000 0.000000 0.500000 basis 0.000000 0.500000 0.500000 basis 0.250000 0.250000 0.250000 basis 0.750000 0.750000 0.250000 basis 0.750000 0.250000 0.750000 basis 0.250000 0.750000 0.750000
region r1 block -5 30 -40 15 0 75 units box
create_atoms 1 region r1 basis 1 1 basis 2 1 basis 3 1 basis 4 1 basis 5 1 basis 6 1 basis 7 1 basis 8 1

# --- Fill 2: Copper — ComponentC  [Copper] ---
lattice custom 3.6149 a1 1.000000000000 0.000000000000 0.000000000000 a2 0.000000000000 1.000000000000 0.000000000000 a3 0.000000000000 0.000000000000 1.000000000000 basis 0.000000 0.000000 0.000000 basis 0.500000 0.500000 0.000000 basis 0.500000 0.000000 0.500000 basis 0.000000 0.500000 0.500000
region r2 block -35 40 -60 -10 0 40 units box
create_atoms 3 region r2 basis 1 3 basis 2 3 basis 3 3 basis 4 3

# --- Fill 3: Indium Phosphide — ComponentB  [Indium Phosphide] ---
lattice custom 5.8687 a1 0.642787609687 0.000000000000 -0.766044443119 a2 0.000000000000 1.000000000000 0.000000000000 a3 0.766044443119 0.000000000000 0.642787609687 basis 0.000000 0.000000 0.000000 basis 0.500000 0.500000 0.000000 basis 0.500000 0.000000 0.500000 basis 0.000000 0.500000 0.500000 basis 0.250000 0.250000 0.250000 basis 0.750000 0.750000 0.250000 basis 0.750000 0.250000 0.750000 basis 0.250000 0.750000 0.750000
region r3 block -165 -25.8687 -40 -20 0 35 units box
create_atoms 4 region r3 basis 1 4 basis 2 4 basis 3 4 basis 4 4 basis 5 2 basis 6 2 basis 7 2 basis 8 2

# --- neutral pair style (no forces; clean build, not equilibration) ---
pair_style zero 2.4
pair_coeff * *

# --- overlap cleanup (delete near-coincident atoms) ---
# cutoff 1.2 Å must stay below the smallest real bond length
delete_atoms overlap 1.2 all all

# --- initialise + dump the assembled sample ---
dump 1 all xyz 1 sample.xyz
dump_modify 1 element C P Cu In
run 0

# To equilibrate instead of a clean build, enable MD (pass MDOptions):
# a real interatomic potential + minimize/run replaces this block.
