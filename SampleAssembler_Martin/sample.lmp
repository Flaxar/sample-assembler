# ======================================================================
# Sample Assembler build
# Generated by Sample Assembler — builds geometry and dumps a
# LAMMPS 'custom' snapshot (id type x y z) for TEM multislice.
# ======================================================================

units metal
atom_style atomic
boundary p p p
atom_modify map yes
lattice none 1.0   # placeholder; each fill sets its own lattice

region simbox block -165 40 -60 15 0 75 units box
create_box 4 simbox

# --- masses (global atom types) ---
mass 1 12.011   # C
mass 2 69.723   # Ga
mass 3 74.922   # As
mass 4 183.84   # W

# --- Fill 1: Diamond (C) — ComponentA  [Diamond (C)] ---
lattice custom 3.5668 a1 1.000000000000 0.000000000000 0.000000000000 a2 0.000000000000 1.000000000000 0.000000000000 a3 0.000000000000 0.000000000000 1.000000000000 basis 0.000000 0.000000 0.000000 basis 0.500000 0.500000 0.000000 basis 0.500000 0.000000 0.500000 basis 0.000000 0.500000 0.500000 basis 0.250000 0.250000 0.250000 basis 0.750000 0.750000 0.250000 basis 0.750000 0.250000 0.750000 basis 0.250000 0.750000 0.750000
region r1 block -5 30 -40 15 0 75 units box
create_atoms 1 region r1 basis 1 1 basis 2 1 basis 3 1 basis 4 1 basis 5 1 basis 6 1 basis 7 1 basis 8 1

# --- Fill 2: Gallium Arsenide — ComponentB  [Gallium Arsenide] ---
lattice custom 5.653 a1 1.000000000000 0.000000000000 0.000000000000 a2 0.000000000000 1.000000000000 0.000000000000 a3 0.000000000000 0.000000000000 1.000000000000 basis 0.000000 0.000000 0.000000 basis 0.500000 0.500000 0.000000 basis 0.500000 0.000000 0.500000 basis 0.000000 0.500000 0.500000 basis 0.250000 0.250000 0.250000 basis 0.750000 0.750000 0.250000 basis 0.750000 0.250000 0.750000 basis 0.250000 0.750000 0.750000
region r2 block -165 -25.8687 -40 -20 0 35 units box
create_atoms 2 region r2 basis 1 2 basis 2 2 basis 3 2 basis 4 2 basis 5 3 basis 6 3 basis 7 3 basis 8 3

# --- Fill 3: Tungsten — ComponentC  [Tungsten] ---
lattice custom 3.1652 a1 1.000000000000 0.000000000000 0.000000000000 a2 0.000000000000 1.000000000000 0.000000000000 a3 0.000000000000 0.000000000000 1.000000000000 basis 0.000000 0.000000 0.000000 basis 0.500000 0.500000 0.500000
region r3 block -35 40 -60 -10 0 40 units box
create_atoms 4 region r3 basis 1 4 basis 2 4

# --- neutral pair style (no forces; clean build, not equilibration) ---
pair_style zero 2.4
pair_coeff * *

# --- overlap cleanup (delete near-coincident atoms) ---
# cutoff 1.2 Å must stay below the smallest real bond length
delete_atoms overlap 1.2 all all

# --- initialise + dump the assembled sample ---
run 0
write_dump all custom sample.xyz id type x y z modify sort id

# To equilibrate instead of a clean build, enable MD (pass MDOptions):
# a real interatomic potential + minimize/run replaces this block.
