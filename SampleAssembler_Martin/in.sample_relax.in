# # Generated by Sample Assembler         # Informační komentář.
# units metal                             # Nastavuje soustavu jednotek na "metal" (vzdálenosti v Ångströmech, energie v eV, čas v pikosekundách).
# atom_style atomic                       # Definuje typ částic (jednoduché atomy bez náboje a bez explicitních molekulových vazeb).
# boundary p p p                          # Nastavuje periodické okrajové podmínky ve všech třech osách (x, y, z) - simuluje nekonečný materiál.
# read_data sample.lmp                    # Načte počáteční pozice atomů a velikost simulačního boxu ze zadaného souboru.

# pair_style tersoff                      # Vybírá Tersoffův potenciál, který se typicky používá pro kovalentní materiály jako Si a Ge.
# pair_coeff * * SiGe_Tersoff.tersoff Si Ge # Přiřadí konkrétní parametry potenciálu ze souboru a namapuje typ atomu 1 na Si a typ 2 na Ge.

# #delete_atoms overlap 1.2 all all          # Smaže atomy, které jsou k sobě blíže než 1 Ångström (zabraňuje nekonečným silám a "explozi" simulace na začátku).
# thermo 10                              # Do terminálu/logu se budou vypisovat termodynamické veličiny (teplota, energie, tlak) každých 500 kroků.
# timestep 0.001                          # Nastavuje délku jednoho časového kroku na 0.001 pikosekundy (1 femtosekunda).
# velocity all create 1 90210 loop geom   # Přiřadí všem atomům počáteční rychlosti odpovídající teplotě 1 Kelvin (90210 je seed pro generátor náhodných čísel).

# fix anneal_heat all nvt temp 1 300 0.1  # Aplikuje termostat (NVT ansámbl), který plynule zahřívá systém z 1 K na 500 K. Hodnota 0.1 je tlumící parametr (damping) v pikosekundách.
# run 5000                                # Spustí simulaci zahřívání na 5000 kroků (celkem 5 pikosekund).
# unfix anneal_heat                       # Ukončí proces zahřívání (odstraní fix).

# fix anneal_cool all nvt temp 300 1.0 0.1 # Aplikuje nový termostat, který systém plynule zchladí z 500 K zpět na 1 K.
# run 5000                                # Spustí simulaci chlazení na 5000 kroků.
# unfix anneal_cool                       # Ukončí proces chlazení.

# min_style cg                            # Nastavuje algoritmus pro minimalizaci energie na metodu sdružených gradientů (Conjugate Gradient).
# minimize 1.0e-6 1.0e-8 1000 10000       # Spustí hledání minima energie (relaxaci). Zastaví se, pokud změna energie klesne pod 10^-6, síla pod 10^-8, po 1000 iteracích, nebo 10000 výpočtech síly.

# # --- PUVODNI KOD ---

# # # Výpočet tenzoru napětí pro každý atom
# # compute peratomstress all stress/atom NULL

# # # Nastavení vlastního (custom) formátu výpisu
# # # Vypíše: id, značku prvku, souřadnice (x, y, z) a 6 složek tenzoru napětí (xx, yy, zz, xy, xz, yz)
# # dump 1 all custom 1 sample.lammpstrj id element x y z c_peratomstress[1] c_peratomstress[2] c_peratomstress[3] c_peratomstress[4] c_peratomstress[5] c_peratomstress[6]
# # dump_modify 1 element Si Ge sort id
# # run 0                                   # Tzv. nultý krok. Simulace se neposune v čase, ale donutí LAMMPS vypsat aktuální (zrelaxovaný) stav do zadaného souboru sample.xyz.
# # undump 1                                # Zavře výstupní soubor.

# # --- ZAČÁTEK NOVÉHO KÓDU ---

# # 1. Nejprve musíme říct LAMMPSu, aby napětí pro každý atom vůbec spočítal
# compute peratomstress all stress/atom NULL

# # 2. Nastavení vlastního (custom) formátu výpisu
# # Vypíše: id, značku prvku, souřadnice (x, y, z) a 6 složek tenzoru napětí (xx, yy, zz, xy, xz, yz)
# dump 1 all custom 1 sample_2.lammpstrj id element x y z c_peratomstress[1] c_peratomstress[2] c_peratomstress[3] c_peratomstress[4] c_peratomstress[5] c_peratomstress[6]
# dump_modify 1 element Si Ge sort id

# run 0                                   # Tzv. nultý krok. Simulace se neposune v čase, ale vygeneruje soubor
# undump 1                                # Zavře výstupní soubor

# Generated by Sample Assembler         # Informační komentář.
units metal                             # Nastavuje soustavu jednotek na "metal" (vzdálenosti v Ångströmech, energie v eV, čas v pikosekundách).
atom_style atomic                       # Definuje typ částic (jednoduché atomy bez náboje a bez explicitních molekulových vazeb).
boundary p p s                          # Nastavuje periodické okrajové podmínky ve všech třech osách (x, y, z) - simuluje nekonečný materiál.
read_data sample_lattice_parameter.lmp                    # Načte počáteční pozice atomů a velikost simulačního boxu ze zadaného souboru.

pair_style tersoff                      # Vybírá Tersoffův potenciál, který se typicky používá pro kovalentní materiály jako Si a Ge.
pair_coeff * * SiGe_Tersoff.tersoff Si Ge # Přiřadí konkrétní parametry potenciálu ze souboru a namapuje typ atomu 1 na Si a typ 2 na Ge.

#delete_atoms overlap 1.2 all all       # Smaže atomy, které jsou k sobě blíže než 1.2 Ångström.

thermo 10                               # Do logu se budou vypisovat termodynamické veličiny každých 10 kroků.
thermo_style custom step temp pe ke etotal press pxx pyy pzz # Definuje přesné sloupce pro výpis (důležité pro Python grafy).
timestep 0.001                          # Nastavuje délku jednoho časového kroku na 0.001 pikosekundy (1 femtosekunda).

# --- 1. MINIMALIZACE (Odstranění počátečních pnutí) ---
min_style cg                            # Nastavuje algoritmus pro minimalizaci energie na metodu sdružených gradientů.
minimize 1.0e-6 1.0e-8 1000 10000       # Zrelaxuje strukturu před začátkem simulace v čase.

# --- 2. ŽÍHÁNÍ A TERMALIZACE (Molekulová dynamika) ---
velocity all create 1 90210 loop geom   # Přiřadí všem atomům počáteční rychlosti odpovídající teplotě 1 Kelvin.

fix anneal_heat all nvt temp 1 500 0.1  # Plynule zahřívá systém z 1 K na 300 K.
run 5000                                # Spustí simulaci zahřívání na 5000 kroků.
unfix anneal_heat                       # Ukončí proces zahřívání.

fix anneal_cool all nvt temp 500 1.0 0.1 # Plynule zchladí systém z 300 K zpět na 1 K.
run 5000                                # Spustí simulaci chlazení na 5000 kroků.
unfix anneal_cool                       # Ukončí proces chlazení.

# === Plynulé zahřívání s NPT termostatem a barostatem ===
# iso 0 0 1.0 znamená: udržuj izotropní tlak 0 barů na začátku i na konci, tlumící parametr 1.0 ps
# fix anneal_heat all npt temp 1 500 0.1 iso 0 0 1.0
# run 5000
# unfix anneal_heat

# # Plynulé chlazení s NPT
# fix anneal_cool all npt temp 500 1.0 0.1 iso 0 0 1.0
# run 5000
# unfix anneal_cool
# === === === === === === ===

# --- 3. FINÁLNÍ VÝPIS DAT ---
# Výpočet tenzoru napětí pro každý atom
compute peratomstress all stress/atom NULL

# Nastavení vlastního (custom) formátu výpisu do .lammpstrj
# Vypíše: id, značku prvku, souřadnice (x, y, z) a 6 složek tenzoru napětí (xx, yy, zz, xy, xz, yz)
dump 1 all custom 1 sample_3_sss.lammpstrj id element x y z c_peratomstress[1] c_peratomstress[2] c_peratomstress[3] c_peratomstress[4] c_peratomstress[5] c_peratomstress[6]
dump_modify 1 element Si Ge sort id

run 0                                   # Nultý krok (čas stojí). Vygeneruje finální výstupní soubor.
undump 1                                # Zavře výstupní soubor.